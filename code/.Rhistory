geom_jitter( aes(x=obj, y= as.numeric(hier_s), colour = "Hierarchical"), alpha = 0.6,
height = jitter_amount, width = jitter_amount, size = 2) +
scale_colour_manual(name = "Models using scoring", values = values_obj, breaks = model_names ) +
new_scale_colour() +
geom_jitter( aes(x=obj, y= as.numeric(p_lu_s), colour = "Plackett-Luce"),alpha = 0.6,
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(mallows_s), colour = "Mallows"),alpha = 0.6,
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(thurst_s), colour = "Thurstonian"),alpha = 0.6,
height = jitter_amount, width = jitter_amount, size = 2) +
scale_colour_manual(name = "Models using ranking", values = values_obj, breaks = model_names ) +
new_scale_colour() +
geom_jitter( aes(x=obj, y= as.numeric(mallows_bin_s), colour = "Mallows-Binomial"),alpha = 0.6,
height = jitter_amount, width = jitter_amount, size = 2) +
scale_colour_manual(name = "Joint model", values = values_obj, breaks = model_names ) +
scale_y_continuous(name = "Z-score of latent quality") +
xlab("") +
xlab("Object") +
ggtitle(paste("Z-scores of ten best objects by model")) +
theme_bw() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=0.5))
library(INLA)
library(INLAjoint)
#| echo: false
# Importing scoring and ranking data
dat_scores <- read.csv("../data/clean/scores_long.csv")
dat_ranks <- read.csv("../data/clean/rank_full_long.csv")
# Joining scores and ranks
dat_joint <- dat_scores
dat_joint$value_rank <- rep(NA, 280)
dat_joint$value_rank[dat_joint$RandomRevID %in% unique(dat_ranks$RandomRevID)] <-
dat_ranks$value
#Substituting grant_id for INLA joint
dat_joint$grant_id <- as.numeric(gsub('x', replacement =  "", dat_joint$grant_id))
# Only select complete cases
dat_as_is <- dat_joint
dat_c_cases <- dat_joint[complete.cases(dat_joint)]
dat_c_cases <- dat_joint[complete.cases(dat_joint),]
View(dat_as_is)
View(dat_c_cases)
View(dat_as_is)
# Standardising everything
dat_as_is$std_score <- (dat_as_is$value - mean(dat_as_is$value)) / sd(dat_as_is$value)
# Standardising everything
dat_as_is$std_score <- (dat_as_is$value - mean(dat_as_is$value)) / sd(dat_as_is$value)
dat_as_is$std_rank  <- (dat_as_is$value_rank - mean(dat_as_is$value_rank)) / sd(dat_as_is$value_rank)
View(dat_as_is)
# Standardising everything
dat_as_is$std_score <- (dat_as_is$value - mean(dat_as_is$value)) / sd(dat_as_is$value)
dat_as_is$std_rank  <- (dat_as_is$value_rank - mean(dat_as_is$value_rank)) / sd(dat_as_is$value_rank)
# Standardising everything
dat_as_is$std_score <- (dat_as_is$value - mean(dat_as_is$value, na.rm = T)) / sd(dat_as_is$value, na.rm = T)
dat_as_is$std_rank  <- (dat_as_is$value_rank - mean(dat_as_is$value_rank, na.rm = T)) / sd(dat_as_is$value_rank, na.rm = T)
View(dat_as_is)
View(dat_as_is)
dat_as_is <- dat_as_is[, c(1,2,5,6)]
View(dat_as_is)
# Overview of data
head(dat_as_is)
# Fitting model
inla_sr_joint <- joint(
formLong = list(
std_score  ~ 1 + (1 | grant_id) + (1| RandomRevID),
std_rank  ~ 1 + (1 | grant_id)
),
dataLong = dat_as_is, id = "grant_id",
family  = c("gaussian", "gaussian"),
corLong = T   # Please check the correlation structure again if you refit model
)
inla_sr_joint_complete$summary.random
# Fitting model
inla_sr_joint_complete <- joint(
formLong = list(
std_score  ~ 1 + (1 | grant_id) + (1| RandomRevID),
std_rank  ~ 1 + (1 | grant_id)
),
dataLong = dat_c_cases, id = "grant_id",
family  = c("gaussian", "gaussian"),
corLong = T
)
