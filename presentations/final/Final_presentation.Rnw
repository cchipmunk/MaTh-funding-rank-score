\begin{frame}{Definition: Mallows Model}

\textbf{Objective:} Determine an underlying ranking order $R^*$ and the dispersion in the ranking $\eta$

\textbf{Observation level:} Ranking order $R_j$

\vspace{1cm} \pause

\textbf{Kendall distance between two linear orders} 
\begin{gather*}
d(R_j, R^* ) = \sum_{i,l = 1}^n \mathds{1}\{o_i \ \ {\succ}_{R_j}  \ \ o_l \quad \text{and} \quad o_l \ \ {\succ}_{R^*}  \ \ o_i\}
\end{gather*}

$\rightarrow$ Minimal amount of swaps in objects necessary to exchange two linear orders.

\vspace{1cm}

\end{frame}


\begin{frame}{Definition: Mallows Model}

\textbf{Objective:} Determine an underlying ranking order $R^*$ and the dispersion in the ranking $\eta$

\textbf{Observation level:} Ranking order $R_j$


\begin{gather*}
\mathbb{P}[R_j| R^* , \eta] = \frac{\exp(-\eta \ \ d(R_j, R^*))}{\psi_{\mathcal{O}}(\eta)} \\
d(R_j, R^* ) = \sum_{i,l = 1}^n \mathds{1}\{o_i \ \ {\succ}_{R_j}  \ \ o_l \quad \text{and} \quad o_l \ \ {\succ}_{R^*}  \ \ o_i\}
\end{gather*}

with the normalising constant
\begin{gather*}
\psi_{\mathcal{O}}(\eta) = \sum_{\mathcal{L}(\mathcal{O})}  \exp(-\eta \ \ d(R_j, R^*)),
\end{gather*} \vspace{-0.3cm}

\hfill \parencite{mallows_1957}

\end{frame}

