\begin{frame}{Bayesian Hierarchical Model for Scores}


\end{frame}


\begin{frame}{Bayesian Modelling}

\textbf{Bayes' Theorem}
\begin{equation*}
\mathbb{P}[A|B] = \frac{\mathbb{P}[B|A] * \mathbb{P}[A]}{\mathbb{P}[B]} 
\end{equation*}
\vspace{0.5cm} \pause

\textbf{In our context:} Learning the object qualities $\bm{\theta}$ from data $S$ and $R$ \\[0.5cm] \pause
\begin{gather*}
f(\bm{\theta}| S_j, R_j) =  \frac{f(S, R | \bm{\theta}) * f(\bm{\theta})}{f(S, R)} \\[0.5cm]
\underbrace{f(\bm{\theta}| S, R)}_{Posterior} \propto  \underbrace{f(S, R | \bm{\theta})}_{Likelihood} * \underbrace{f(\bm{\theta})}_{Prior}
\end{gather*}

\end{frame}

\begin{frame}{Posterior Distribution Estimation}
\textbf{Markov Chain Monte Carlo simulations (\textsc{Mcmc})} \parencite{metropolis_equation_1953}
\begin{itemize}
\item Define model
\item Generate samples of the posterior distribution through a simulation  
\item Assess convergence of the simulation
\end{itemize}

\pause

\textbf{Integrated Nested Laplace approximation (\textsc{Inla})} \parencite{rue_approximate_2009}
\begin{itemize}
\item Define model (latent gaussian)
\item Estimate conditional posterior distributions using Laplace approximations
\end{itemize}


\end{frame}


\begin{frame}{Hierarchical Model for Scores}

\textbf{Objective:} Model the quality $\theta_i$ of objects

\textbf{Observation:} Individual scores $y_{ij}$ \vspace{-0.5cm} \pause

\begin{gather*}
y_{ij} | \theta_i^{\ hier}, \lambda_{j} \quad \sim \quad N(\mu + \theta_i^{\ hier} + \lambda_{j}\ , \frac{1}{\tau_y}) \\
\theta_i^{\ hier} \sim \ N(0,  \frac{1}{\tau_{\theta}}), \quad \quad \lambda_{j} \sim N(0, \frac{1}{\tau_\lambda}) 
\end{gather*}

where $\theta_i^{\ hier}$, is the estimated quality of the objects, $\lambda_j$ is an assessor specific effect,

where $\mu$ is the mean score of all objects,  

where $\tau_{\theta}, \tau_{\lambda}, \tau_y$ are hyperpriors for precision

\hfill \parencite{heyard_rethinking_2022}


\end{frame}

\begin{frame}{Model Fitting}


\textbf{Using \textsc{Mcmc}} (\texttt{rjags}) \vspace{-0.5cm}

\begin{gather*}
y_{ij} | \theta_i^{\ hier}, \lambda_{j} \quad \sim \quad N(\mu + \theta_i^{\ hier} + \lambda_{j}\ , \frac{1}{\tau_y}) \\
\theta_i^{\ hier} \sim \ N(0,  \frac{1}{\tau_{\theta}}), \quad \quad \lambda_{j} \sim N(0, \frac{1}{\tau_\lambda}) 
\end{gather*}

\begin{itemize}
\item 20000 iterations adaptive sampling and burn-in, 80000 iterations of Gibbs sampling
\item Thinning of 20 
\end{itemize}


\textbf{Using \textsc{Inla}} (\texttt{inla})
\begin{gather*}
y = \beta_0 + \alpha_1 + \alpha_2 + \epsilon \\
\alpha_1 \sim N(0, \frac{1}{\tau_{\theta}}), \quad \quad \alpha_2 \sim N(0, \frac{1}{\tau_{\lambda}}), \quad \quad \epsilon \sim N(0, \frac{1}{\tau_y})
\end{gather*}


\end{frame}


