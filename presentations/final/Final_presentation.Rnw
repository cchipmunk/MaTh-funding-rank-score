\begin{frame}{Discussion}
\textbf{Models disagree for ordering between rank 1-3, and rank 7-12}
\begin{itemize}
\item Between Scoring and ranking models
\item Within ranking models
\item Different models favour different object properties
\end{itemize}


\textbf{Bayesian posterior distribution estimation procedure}
\begin{itemize}
\item Both estimation procedures yield very simillar results
\end{itemize}

\textbf{Limitations}
\begin{itemize}
\item Only one dataset analysed
\item No ground truth available (not a simulation dataset)
\item Ranking data only partial
\end{itemize}


\end{frame}




\begin{frame}{Thesis Objectives}
\vspace{-1cm}
\begin{gather*}
\text{\textcolor{ForestGreen}{"Towards Bayesian joint modelling of ranks and scores}} \\
\text{\textcolor{ForestGreen}{in the assessment of grant proposal quality"}}
\end{gather*}

\begin{enumerate}
\item  Identify and describe existing methods for quality assessment using scores and ranks. 
\item  Reproduce and compare these methods on a data set from Gallo et al. (2023). \nocite{gallo_new_2023} 
\item  Compare the results of the Integrated Nested Laplace Approximation (INLA) and Markov Chain Monte Carlo (MCMC) approaches to posterior distribution estimation.  
\item Extend the Bayesian hierarchical model from Heyard et al. (2022) \nocite{heyard_rethinking_2022} to jointly model ranks and scores and reduce the uncertainty in the assessment of grant proposal quality.
\end{enumerate}

\end{frame}


\begin{frame}{Outlook - Joint Modelling}
\textbf{The Mallows-binomial joint model for ranks and scores already exists}
\begin{itemize}
\item More weight is given to scoring observations than to ranking observations
\item Model defined in frequentist framework
\end{itemize}

\textbf{Paths Towards Joint Modelling}
\begin{itemize}
\item Mallows-Binomial model with weighted likelihood
\item Using ranking models to set priors on qualities $\theta_i$ in the hierarchical model
\item Joint latent Gaussian model with correlated random effects in \textsc{Inla} framework
\end{itemize}

\end{frame}

\begin{frame}{Joint Model using inlajoint}

\textbf{Transforming the data through z-scoring}

\begin{equation*}
y^{z}_{ij} = \frac{y_{ij} - \hat{\bar{y}}}{\hat{\sigma}_y} \quad \quad r^{z}_{ij} = \frac{r_{ij} - \hat{\bar{r}}}{\hat{\sigma}_r}
\end{equation*} 

\textbf{Defining Joint model}
\begin{gather*}
\begin{cases}
    y^{z}_{ij} = \beta_0^y + \theta^{y}_{i} + \lambda^{y}_{j}  \\
    r^{z}_{ij} = \beta_0^r + \theta^{r}_{i} 
\end{cases} \\[0.5cm]
\theta^{y} \sim N(0, \sigma_{\theta^y}^2) \quad \quad  \theta^{r} \sim N(0, \sigma_{\theta^r}^2)  \\[0.25cm]
\text{corr}(\theta^{y},  \theta^{r}) = \rho_{\theta} \\
\end{gather*} 
\end{frame}

