        -0.74 to -0.51 & \footnotesize -0.71 to -0.48 \\
        \hline
    \end{tabular}
\end{table}
\setstretch{1}


\end{frame}


\begin{frame}{Comparison of Models}
\textbf{Results from different models are on different scales} \pause


Option 1: Transform all scoring and ranking values through z-scoring 


\begin{equation*}
z_i^{k} =
\begin{cases}
\frac{\hat{\theta}_{i}^k - \hat{\bar{\theta}}^k}{\hat{\sigma}_{\theta^k}}, \quad
 k = \{mean, \ hier,\ pl\text{-}lu,\ thurst \}\\
\frac{\hat{r}_{i}^k - \hat{\bar{r}}^k}{\hat{\sigma}_r^k}, \quad 
 k = \{mlw,\ mbin\} 
\end{cases}
\end{equation*} \pause


Option 2: Compare final orderings directly

\begin{equation*}
\mathcal{F}_k(\mathcal{O}), \quad k = \{mean,\ hier,\ pl\text{-}lu,\ mlw,\ thurst,\ mbin,\}
\end{equation*}


\end{frame}


