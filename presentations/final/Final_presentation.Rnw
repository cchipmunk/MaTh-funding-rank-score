\begin{frame}{Panel Review Data}

\begin{columns}

\begin{column}{0.6\textwidth}


\textbf{Scoring Data}

\begin{itemize}
\item Proposals are scored on an absolute scale.
\item This scale can either be ordinal or continuous.
\item The assessment of each proposal should be independent from all other proposals.
\end{itemize}



\vspace{0.7cm}

\rule[6pt]{\textwidth}{0.4pt}

\textbf{Ranking Data}

\begin{itemize}
\item Proposals are ranked on a relative scale.
\item Either all or only top-k proposals are ranked. 
\item The assessment of each proposal depends directly on the other proposals.
\end{itemize}



\end{column}

\begin{column}{0.4\textwidth}

\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.06]{figures/scoring_2}
     \centering
\end{figure}


\rule{\textwidth}{0.4pt}


\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.07]{figures/ranking_2}
     \centering
\end{figure}


\end{column}

\end{columns}

\end{frame}



\begin{frame}{Thesis Objectives}
\vspace{-1cm}
\begin{gather*}
\text{\textcolor{ForestGreen}{"Towards Bayesian joint modelling of ranks and scores}} \\
\text{\textcolor{ForestGreen}{in the assessment of grant proposal quality"}}
\end{gather*}

\pause
\begin{enumerate}
\item  Identify and describe existing methods for quality assessment using scores and ranks. \pause
\item  Reproduce and compare these methods on a data set from Gallo et al. (2023). \nocite{gallo_new_2023} \pause
\item  Compare the results of the Integrated Nested Laplace Approximation (INLA) and Markov Chain Monte Carlo (MCMC) approaches to posterior distribution estimation.  \pause
\item Extend the Bayesian hierarchical model from Heyard et al. (2022) \nocite{heyard_rethinking_2022} to jointly model ranks and scores and reduce the uncertainty in the assessment of grant proposal quality.
\end{enumerate}

\end{frame}


\begin{frame}{Definitions (1/3)}
\textbf{Objects, assessors, latent quality and final ordering} \parencite{xia_learning_2019}
\begin{align*}
    \mathbf{\mathcal{O}} &= \{o_1, o_2, ..., o_n\} \\
    \mathbf{\mathcal{A}} &= \{a_1, a_2, ..., a_m\} \\
    \theta_i^{\ k} &\rightarrow \text{Latent quality of object } o_i \text{ according to model } k  \\
    \mathcal{F}_k(\mathcal{O}) &\rightarrow  \text{Final ordering of objects } \mathcal{O} \text{ according to model } k  \\
\end{align*} \pause
\textbf{Conventions}
\begin{itemize}
\item The lower the value of the latent quality, the higher the object quality.
\item $\mathcal{F}_k(\mathcal{O})$ is obtained by sorting  $\theta_i^{\ k}$ in ascending order.
\end{itemize}





\end{frame}

\begin{frame}{Definitions (2/3)}

\textbf{Scoring data} \parencite{heyard_rethinking_2022, xia_learning_2019}
\begin{align*}
     y_{ij} &\rightarrow \text{score given to object } o_i \text{ by assessor } a_j \\
     S_{j} &= \text{Set of grades given to } \mathcal{O} \text{ by a specific assessor } a_j \\
     S &= \{S_1, S_2, ..., S_{m}\}, \text{the scoring data}
\end{align*}  \pause
\textbf{Conventions}

\begin{itemize}
\item The lower the score, the higher the object quality.
\item We assume the latent quality $\theta_i^{\ k}$ of each object is associated with the given scores $y_{ij}$
\end{itemize}

\end{frame}


\begin{frame}{Definitions (3/3)}

\textbf{Ranking data} (\cite{marden_analyzing_2014, xia_learning_2019})
\begin{align*}
\mathcal{L}(\mathcal{O}) &\rightarrow \text{All possible orderings of } \mathcal{O} \\
R_j \ \epsilon \ \mathcal{L}(\mathcal{O}) &\rightarrow \text{Ranking order given by assessor } a_j \\
R  &= \{R_1, R_2, ..., R_m\}, \text{the Ranking data} 
\end{align*} \pause
\textbf{Example}
\begin{gather*} \setstretch{1.5}
\mathcal{O} = \{ o_1, o_2, o_3 \} \\
\mathcal{L}(\mathcal{O}) = \begin{Bmatrix}
[o_1 \succ o_2 \succ o_3] & [o_1 \succ o_3 \succ o_2] & [o_2 \succ o_1 \succ o_3]\\
[o_2 \succ o_3 \succ o_1] & [o_3 \succ o_1 \succ o_2] & [o_3 \succ o_2 \succ o_1]
\end{Bmatrix}\\
R_1 = \{ [o_1 \succ o_3 \succ o_2]\}
\end{gather*}
\setstretch{1}

\end{frame}



\begin{frame}{Differences between Ranking and Scoring Data}
\textbf{Observations on different levels:}
\begin{itemize}
\item $m$ assessors give scores to all $n$ objects $\rightarrow m*n$ observations.
\item $m$ assessors give each one linear order $\rightarrow m$ observations.
\end{itemize}

\pause

\textbf{Transforming Linear orders to ranking observations} \parencite{stevens_theory_1946, mosteller_data_1977, velleman_nominal_1993}

\begin{equation*}
r_{ij} \rightarrow \text{ position in ranking order } R_j \text{ of object } o_i 
\end{equation*}

\pause

\textbf{Example:}
\begin{gather*}
R_1 = [o_1 \succ o_3 \succ o_2] \\
r_{31} = 2
\end{gather*}







\end{frame}




