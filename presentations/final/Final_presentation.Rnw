\begin{frame}{Supl. Markov-chain Monte-Carlo}

\textbf{Monte-Carlo simulation:} Generating independent samples of a (posterior) distributions through repeated sampling using a proportionality constraint. \parencite{metropolis_monte_1949}

\textbf{Markov chains:} Enables dependant sampling, where "important" domains of the solution space are more often sampled than the rest of the space. This makes Monte Carlo simulation more efficient. \parencite{metropolis_equation_1953} \pause

The dependant samples converge towards the distribution of a posterior distirbution if:
\begin{itemize}
\item the Markov chain is irreducible
\item The Markov chain is aperiodic
\item The Markov chain satisfies detail balance
\end{itemize}

\end{frame}

\begin{frame}{Supl. Markov-chain \& Independent sampling}


\textbf{Markov chain:} A series of numbers ${x^{(1)}, x^{(2)} , ..., x^{(q)}}$ in which any step $x^{(q)}$ depends, and only depends on the previous step $x^{(q-1)}$.

\textbf{Irreducibility:} A Markov chain is said to be irreducible if there exists a transition between any pair $x$ and $x'$ in a finite number of steps $s$.

\textbf{Aperiodicity:} A Markov chain is said to be aperiodic, if the greatest common divisor of all the possible number of steps $\bm{s} = \{s_1, s_2, ..., s_q\}$ between $x$ and itself is 1.

\textbf{Detailed balance} The transition probability $\mathbb{P}[T(x \rightarrow x')]$ between any $x$ and $x'$ satisfy the following property: \vspace{-1cm}

\begin{gather*}
\mathbb{P}[x] * \mathbb{P}[T(x \rightarrow x')] = \mathbb{P}[x'] * \mathbb{P}[T(x' \rightarrow x)]
\end{gather*}


\end{frame}


\begin{frame}{Supl. Metropolis Hasting algorithm}

\textbf{1. Initiate the Markov chain:} Choose a value for $x^{(1)}$, either randomly, or using prior knowledge about the target distribution. 

\textbf{2. Propose a candidate value:} Choose a new candidate value for the chain using an arbitrary function $f(x^{(q+1)} | x^{(q)})$.

\textbf{3. Perform the Metropolis test:} The candidate $x^{(q+1)}$ is accepted with a probability: 
\begin{equation*}
\text{min}(1, \frac{f(x^{(q+1)}) * f(x^{(q)} | x^{(q+1)}) }{ f(x^{(q)}) * f(x^{(q+1)} | x^{(q)}))}
\end{equation*}
If the candidate is not accepted a new candidate is proposed using step two of this algorithm.

\textbf{4. Repeat until convergence:} Repeat from step two until the distribution of the samples generated by the Markov-chain converges

\hfill \parencite{hastings_monte_1970}

\end{frame}


\begin{frame}{Supl. Gibbs Sampling is a Metropolis-Hasting Algorithm}

\begin{gather*}
x_a^{(q+1)} \sim f(x_a | x_1^{(q + 1)}, ..., x_{a-1}^{(q + 1)}, x_{a+1}^{(q)},  ..., x_{r}^{(q)})  \\  
\text{For all } x_a \in \bm{x} \nonumber
\end{gather*}

\begin{gather*}
\mathbb{P}[\text{acceptance}] = \frac{f(x_a^{(q+1)}) * f(x_a^{(q)}) | x_a^{(q + 1)}) }{ f(x_a^{(q)}) * f(x_a^{(q+1)} | x_a^{(q)})} \\[0.4cm]
x_a^{(q+1)} \independent x_a^{(q)} \\[0.4cm]
\mathbb{P}[\text{acceptance}] = \frac{f(x_a^{(q+1)}) * f(x_a^{(q)}) }{ f(x_a^{(q)} * f(x_a^{(q+1)}) } = 1
\end{gather*}


\end{frame}


\begin{frame}{Supl. Convergence Diagnostics}

\textbf{Using the \texttt{coda} package} \parencite{coda}
\begin{itemize}
\item All parameters converged with $\hat{R} \leq 1.01$  \parencite{gelman_inference_1992}
\item Multivariate $\hat{R} \leq 1.01$
\item Raftery and Lewis (1970) \nocite{raftery_1970} diagnostic suggests a minimal sample size of 3746. 
\begin{itemize}
\item for 95 \% confidence of achieving a precision of 0.005 in the estimation of the 2.5 \% quantile
\end{itemize}
\item Heidelberg's Convergence test (1983) \nocite{heidelberger_simulation_1983} was passed by all four chains
\end{itemize}


\end{frame}


