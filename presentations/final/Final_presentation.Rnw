\begin{frame}{Definition: Mallows-Binomial Model}

\end{frame}


\begin{frame}{Definition: Binomial model}
\textbf{A Binomial model for scores}
\begin{itemize}
\item Scores are assumed to be given on an equally distanced ordinal scale.
\item The scores given to each object is than modelled with a binomial distribution. 
\end{itemize} \pause

\textbf{Example}

\begin{center}
Scores are given on a continuous scale from 1 to 5 with up to one decimal place 

$\downarrow$

Scores are given on an ordinal scale containing 40 levels 

\end{center} \pause

\textbf{In practice}
\begin{equation*}
\text{Score:} \ 2.4 \rightarrow \text{Ordinal score:} \ 14 
\end{equation*}

\end{frame}


\begin{frame}{Definition: Binomial Model}

\textbf{Objective:} Model the quality $\theta_i$ of objects

\textbf{Observation:} individual score $y_{ij}$
\vspace{0.5cm}
\begin{gather*}
y_{ij} | \theta_i, l \  \sim  \  Bin(\theta_i, \nu) \\
\mathbb{P}[y_{ij} | \pi_i, h] = \binom{\nu}{y} \theta_i^{\ y} (1-\theta_i)^{\nu-y},
\end{gather*}

\vspace{0.5cm}


where scores have $\nu$ levels,

where the expected score is $\nu * \theta_i$

\hfill \parencite{pearce_unified_2022}

\end{frame}




\begin{frame}{Definition: Mallows-Binomial Model}

\textbf{Objective:} Model the underlying ordering $R^*$ \pause

\textbf{Observation:} Set of scores and ranks given by a specific assessor $R_j$ and $S_j$



\begin{gather*}
\mathbb{P}[R_j, S_j | \bm{\theta}, \eta]  = \frac{\exp(-\eta \ \ d(R_j, R^*))}{\psi_{\mathcal{O}}(\eta)} \cdot \prod_{i=1}^{n} \binom{\nu}{y_{ij}} \theta_i^{\ y_{ij}} (1 - \theta_i)^{\nu-y_{ij}} \\[10pt]
\bm{\theta} = [\theta_1, ..., \theta_n], \quad R^* = \text{Order}(\theta), \quad \eta > 0
\end{gather*} \vspace{1cm}

\hfill \parencite{pearce_unified_2022}


\end{frame}


