\begin{frame}{Outlook}

\textbf{Modelling reproduction on Gallo et al.}
\begin{itemize}
\item Mallows model for rankng data \parencite{mallows_non_null_1957}
\item Thurstonian model for ranking data \parencite{thurstone_law_1927}
\item Mallows-Binomial joint model \parencite{mallows_binomial}
\item Hierarchical joint modelling
\end{itemize}

\textbf{Steps towards Hierarchical joint modelling}
\begin{enumerate}
\item Translate the ERforResearch package from JAGS to INLA framework.
\item Implement a Bayesian imputation model for ranking data.
\item Implement a joint model for ranking and scores using the INLA joint modelling framework.
\end{enumerate}

\end{frame}





