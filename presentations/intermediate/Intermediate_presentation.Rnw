\begin{frame}{Definitions - Modelling Scoring data}

We define Alternatives, scores and quality, according to Xia et al. (2019) and Heyard et al. (2022) \nocite{xia_learning_2019} \nocite{heyard_rethinking_2022}


\begin{align*}
    \mathbf{\mathcal{A}} &= \{o_1, o_2, ..., o_n\} \\
     y_{i,\ j} &\rightarrow \text{score given to object } o_i \text{ by assessor } j \\
     \theta_i &\rightarrow \text{ quality of } o_i
\end{align*}  



\textbf{Modelling approach}

\begin{itemize}
\item We assume the scores $y_{i,j}$ are associated with a latent quality variable $\theta_i$.
\item We infer $\theta_i$ using multiple methods and sort it to create a ranking of objects.
\end{itemize}

\end{frame}





\begin{frame}{Definition: Mean score model}


1. Model the quality $\theta_i$ through the mean score model as defined in Zehlike et al. (2022): \nocite{zehlike_fairness_2022}
\setstretch{1.2}
\begin{gather*}
\bar{y}_i = \frac{\sum_{j=1}^m y_{ij}}{m} \\
\bar{y} = \frac{\sum_{i=1}^n \bar{y}_i}{n} \\
\hat{\theta}_i^{\ mean} = \bar{y}_i - \bar{y} 
\end{gather*}
\setstretch{1}

2. Infer $\theta_i^{\ mean}$ and sort in descending order to obtain final ranking.


\end{frame}



\begin{frame}{Result: Mean score model}

\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.43]{figures/results/0_mean_score_output}
     \centering
\end{figure}


\end{frame}


\begin{frame}{Shortcomings of Mean score model}



\begin{enumerate}
    \item No measures of uncertainty. \parencite{kaplan_sample_2008} 
    \item Assumes assessors have the same scoring habits.
    \item Assumes subset of proposal assigned doesn't effect scoring.
\end{enumerate}


\end{frame}


\begin{frame}{Definition: Bayesian Hierarchical Scoring}

1. Model the quality $\theta_i$ through the Bayesian Hierarchical model as defined by Heyard et al. (2022): \nocite{heyard_rethinking_2022}
\begin{gather*}
y_{ij} | \theta_i^{\ hier},\lambda_{ij} \ \  \sim N(\bar{y} + \theta_i^{\ hier} + \lambda_{j}\ , \sigma^2) \\
\theta_i^{\ hier} \sim N(0,  \tau^2_{\theta}) \nonumber\\
\lambda_{j} \sim N(0, \tau_\lambda^2) \nonumber
\end{gather*}

2. Infer the posterior distribution of $\theta^{\ hier}_i$ using MCMC.


3. Use $\theta^{\ hier}_i$ to calculate the expected rank of each proposal.

\end{frame}




\begin{frame}{Results: Bayesian Hierarchical Scoring}

\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.17]{figures/results/0_final_hier}
     \centering
\end{figure}

\end{frame}




\begin{frame}{Modelling ranking data}

We define ranking data according to to Xia et al. (2019) and Marden (2014): \nocite{marden_analyzing_2014} \nocite{xia_learning_2019}
\begin{align*}
\mathcal{L}(\mathcal{A}) &\rightarrow \text{All possible orderings of the objects} \\
R_j \ \epsilon \ \mathcal{L}(\mathcal{A}) &\rightarrow \text{Ranking order given by assessor } j \\
R(o_i)  &\rightarrow \text{Rank given to object } o_i
\end{align*}
Example with three objects: \setstretch{1.5}
\begin{gather*}
\mathcal{A} = \{ o_1, o_2, o_3 \} \\
\mathcal{L}(\mathcal{A}) = \begin{Bmatrix}
[o_1 \succ o_2 \succ o_3] & [o_1 \succ o_3 \succ o_2] & [o_2 \succ o_1 \succ o_3]\\
[o_2 \succ o_3 \succ o_1] & [o_3 \succ o_1 \succ o_2] & [o_3 \succ o_2 \succ o_1]
\end{Bmatrix}\\
R_1 = \{ [o_1 \succ o_3 \succ o_2]\}
\end{gather*}
\setstretch{1}



\end{frame}



\begin{frame}{Definition: Plackett-Luce}

Plackett-Luce models ranking data by estimating a set of weights $W = \{w_1, ..., w_n\}$ with a parameter $w_i$ for each object $o_i$. \parencite{plackett_1975}
\begin{equation*}
\mathbb{P}[R(o_1) = 1 \ | \ W = \{w_1, ... \ ,  w_n\} ] = \frac{w_1}{\sum^n_{i = 1}w_i}
\end{equation*}


Example:
\begin{gather*}
\mathcal{A} = \{ o_1, o_2, o_3 \} \\
W = \{w_1 = 0.3, w_2 = 0.2, w_3 = 0.5\} \\
\mathbb{P}[R(o_3) = 1 \ | \ W] = \frac{0.5}{0.3+0.2+0.5} \\
\end{gather*}


\end{frame}




\begin{frame}{Plackett-Luce}

The Plackett-Luce model is sequential, it assumes the data is generated as follows,
{\small
\begin{enumerate}
\item Select an object from $\mathcal{A}$ to be in first position of the ranking using $W$.
\item Remove the weight from $W$ and the object from $\mathcal{A}$
\item Select a new object from $\mathcal{A}$ to be in the next position of the ranking using $W$.
\item Repeat from step 2 until the full ranking is generated.
\end{enumerate}
}

The probability of observing a ranking order can be written as follows,

\begin{equation*}
\mathbb{P}[o_1 \succ ... \succ o_n \ | \ W] = \prod_{i=1}^{n} \ \frac{w_1}{\sum_{i = 1}^{n} w_i} \ * \  \frac{w_2}{\sum_{i = 2}^{n} w_i} \ * \ \cdots \ * \ \frac{w_n}{w_n}
\end{equation*}


\end{frame}



\begin{frame}{Results: Plackett-Luce}

\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.43]{figures/results/0_P_luce_output}
     \centering
\end{figure}


\end{frame}



