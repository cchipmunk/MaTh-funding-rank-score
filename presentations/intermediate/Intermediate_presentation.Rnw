\begin{frame}{Extra slide : Expected Ranks}

\begin{columns}
\begin{column}{0.4\textwidth}
We calculate the Expected ranks using the distributions of $\theta_i$ \parencite{laird_empirical_1989}

\begin{align*}
ER_i &= \mathbb{E}[R(\theta_i)] \\
&= \sum_{i =1}^n \mathbb{P}[\theta_i \leq \theta_j] \\
&= 1 + \sum_{j \neq i} \mathbb{P}[\theta_i \leq \theta_j]
\end{align*}

\end{column}


\begin{column}{0.6 \textwidth}

\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.3]{figures/thurst_rank}
     \centering
\end{figure}

\end{column}
\end{columns}



