\begin{frame}{Panel review data}

\begin{columns}

\begin{column}{0.6\textwidth}


\textbf{Ranking data}
\begin{itemize}
\item Proposals are ranked on a relative scale.
\item Either all or only top-k proposals are ranked. 
\item The assessment of each proposal depends directly on the other proposals.
\end{itemize}

\vspace{0.40cm}

\rule[6pt]{\textwidth}{0.4pt}

\textbf{Scoring data}

\begin{itemize}
\item Proposals are scored on an absolute scale.
\item This scale can either be ordinal or continuous.
\item The assessment of each proposal should be independent from all other proposals.
\end{itemize}



\end{column}

\begin{column}{0.4\textwidth}

\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.07]{figures/ranking_2}
     \centering
\end{figure}


\rule{\textwidth}{0.4pt}


\begin{figure}[H]
     \centering
     \includegraphics[scale = 0.07]{figures/scoring_2}
     \centering
\end{figure}


\end{column}

\end{columns}

\end{frame}









\begin{frame}{Thesis objectives}

\begin{center}
\textcolor{ForestGreen}{"Towards Bayesian joint modelling of ranks and scores to
reduce uncertainty \newline in the assessment of grant proposal quality"}
\end{center}

\begin{enumerate}
\item  Identify and describe existing methods for quality assessment using scores and ranks.
\item Reproduce these methods on a data set from Gallo et al. (2023). \nocite{gallo_new_2023}
\begin{itemize}
\item Scenario: Select the five best proposal from the data set.
\end{itemize}
\item Extend the Bayesian hierarchical model from Heyard et al. (2022) \nocite{heyard_rethinking_2022} to jointly model ranks and scores and reduce the uncertainty in the assessment of grant proposal quality.
\end{enumerate}

\end{frame}




