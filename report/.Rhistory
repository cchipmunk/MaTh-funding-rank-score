# Checking Autocorrelation
col_ns <- paste0("id_quality[",1:28,"]")
for (i in col_ns) {
sim <- m.fit[,i]
acf(sim, main = i)
}
gelman.diag(fit, autoburnin=TRUE)
raftery.diag(fit)
geweke.plot(fit)
library(data.table)
library(pander)
dat <- read.csv("../data/clean/scores_long.csv")
dat$RandomRevID <- as.character(paste0("x", dat$RandomRevID))
dat$RandomRevID <- as.factor(dat$RandomRevID)
dat$grant_id <- as.factor(dat$grant_id)
pander(dat)
# According to INLA documentation "loggamma" is the gamma prior
prec.prior <- list(prec = list(prior = "loggamma", param = c(1.5, 1.5)))
# Model call
fit_inla <-
inla(formula = value ~ 1 + f(grant_id, model = "iid", hyper = prec.prior) +
f(RandomRevID, model = "iid", hyper = prec.prior),
data = dat, quantiles = c(0.25,0.75))
########################
# preprocessing data ###
########################
library(INLA)
# Model call
fit_inla <-
inla(formula = value ~ 1 + f(grant_id, model = "iid", hyper = prec.prior) +
f(RandomRevID, model = "iid", hyper = prec.prior),
data = dat, quantiles = c(0.25,0.75))
summary(fit_inla)
plot(fit_inla)
# Mean model
mean_s <- c(-1.05,  -1,  -1,  -0.93,  -0.8,  -0.75,  -0.72,  -0.71,  -0.63,
-0.6,  -0.6,  -0.6,  -0.21,  -0.1,  0,  0.05,  0.33,  0.35,  0.39,
0.5,  0.5,  0.61,  0.95,  0.97,  1,  1.26,  1.31,  1.42 )
mean_obj <- c("x17",  "x19",  "x25",  "x21",  "x4",  "x23",  "x22",  "x20",  "x6",
"x3",  "x13",  "x16",  "x7",  "x15",  "x1",  "x11",  "x18",  "x24",
"x2",  "x27",  "x28",  "x5",  "x26",  "x8",  "x12",  "x9",  "x10",  "x14")
dat_mean <- as.data.frame(cbind(mean_obj, mean_s))
colnames(dat_mean) <- c("obj", "mean_s")
dat_mean$mean_s <- as.numeric(dat_mean$mean_s)
# Hierarchical scores, We only take JAGS output (they are both so close)
hier_s <- c(-1.04, -0.99, -0.99, -0.92, -0.79, -0.75, -0.73, -0.7, -0.62, -0.6,
-0.59, -0.59, -0.21, -0.12, 0, 0.04, 0.33, 0.34, 0.38, 0.5, 0.5, 0.61,
0.94, 0.96, 0.99, 1.25, 1.3, 1.38)
hier_obj <- c("x17", "x25", "x19", "x21", "x4", "x23", "x22", "x20", "x6", "x3",
"x13", "x16", "x7", "x15", "x1", "x11", "x18", "x24", "x2", "x27",
"x28", "x5", "x26", "x8", "x12", "x9", "x10", "x14")
dat_hier <- as.data.frame(cbind(hier_obj, hier_s))
colnames(dat_hier) <- c("obj", "hier_s")
dat_hier$hier_s <- as.numeric(dat_hier$hier_s)
#Plackett-Luce
p_lu_s <- c(0.7, 0.83, 0.86, 0.88, 0.93, 0.95, 0.95, 0.96, 0.97, 0.99, 0.99)
p_lu_obj <- c("x25", "x19", "x21", "x17", "x4",  "x20", "x22", "x23", "x13", "x3", "x16")
dat_p_lu <- as.data.frame(cbind(p_lu_obj, p_lu_s))
colnames(dat_p_lu) <- c("obj", "p_lu_s")
dat_p_lu$p_lu_s <- as.numeric(dat_p_lu$p_lu_s)
#Mallows
mallows_s <- seq(1,11)
mallows_obj <- c("x17", "x25", "x19", "x21", "x4",  "x23", "x16", "x20", "x22", "x13", "x3")
dat_mallows <- as.data.frame(cbind(mallows_obj, mallows_s))
colnames(dat_mallows) <- c("obj", "mallows_s")
dat_mallows$mallows_s <- as.numeric(dat_mallows$mallows_s)
# Thurstonian
thurst_s <- c(-2.61, -2.59, -2.48, -1.49, -1.27, -0.76, -0.41, -0.21, -0.2, -0.14, 0)
thurst_obj <- c("x25", "x19", "x17", "x21", "x4",  "x23", "x20", "x13", "x16", "x22", "x3")
dat_thurst <- as.data.frame(cbind(thurst_obj, thurst_s))
colnames(dat_thurst) <- c("obj", "thurst_s")
dat_thurst$thurst_s <- as.numeric(dat_thurst$thurst_s)
# Mallows-Binomial
mallows_bin_s <- seq(1,28)
mallows_bin_obj <- c("x17",  "x25",  "x19",  "x21",  "x4",  "x23",  "x20",  "x22",
"x13",  "x16",  "x3",  "x6",  "x7",  "x15",  "x1",  "x11",  "x18",
"x24",  "x2",  "x27",  "x28",  "x5",  "x26",  "x8",  "x12",  "x9",  "x10",  "x14")
dat_mallows_bin <- as.data.frame(cbind(mallows_bin_obj, mallows_bin_s))
colnames(dat_mallows_bin) <- c("obj", "mallows_bin_s")
dat_mallows_bin$mallows_bin_s <- as.numeric(dat_mallows_bin$mallows_bin_s)
whole_dat <- merge(dat_mean, dat_hier, by = "obj", all = T)
whole_dat <- merge(whole_dat, dat_p_lu, by = "obj", all = T)
whole_dat <- merge(whole_dat, dat_mallows, by = "obj", all = T)
whole_dat <- merge(whole_dat, dat_thurst, by = "obj", all = T)
whole_dat <- merge(whole_dat, dat_mallows_bin, by = "obj", all = T)
### Whole data scaling
dat_scaled <- as.data.frame(scale(whole_dat[,2:7]))
dat_scaled$obj <- whole_dat$obj
order_scaled <- dat_scaled[order(dat_scaled$mallows_bin_s),]$obj
dat_scaled$obj <- factor(dat_scaled$obj, levels = order_scaled, ordered = T)
dat_scaled <- dat_scaled[order(dat_scaled$mallows_bin_s),]
dat_scaled
order(dat_scaled$mean_s)
lapply(dat_scaled, function(x){order(x)})
lapply(dat_scaled, function(x){order(x)})
dat_lin_o <- lapply(dat_scaled, function(x){order(x)})
View(dat_lin_o)
dat_lin_o <- as.data.frame(lapply(dat_scaled, function(x){order(x)}))
dat_scaled
dat_lin_o <- as.data.frame(lapply(dat_scaled, function(x){ifelse(is.na(x), NA, order(x)}))
dat_lin_o <- as.data.frame(lapply(dat_scaled, function(x){ifelse(is.na(x), NA, order(x))}))
View(dat_lin_o)
dat_lin_o
# Assigning colours to specific models
model_names <- c("Mean", "Hierarchical",
"Mallows-Binomial",
"Plackett-Luce", "Mallows", "Thurstonian")
colour_names <- c("darkseagreen", "green4",
"cornflowerblue",
"darksalmon", "darkorange", "coral1")
values_obj <- setNames(colour_names, model_names)
# Setting Jitter
jitter_amount <- 0.08
ggplot(dat_lin_o) +
geom_jitter( aes(x=obj, y= as.numeric(mean_s), colour = "Mean"),
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(hier_s), colour = "Hierarchical"),
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(p_lu_s), colour = "Plackett-Luce"),
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(mallows_s), colour = "Mallows"),
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(thurst_s), colour = "Thurstonian"),
height = jitter_amount, width = jitter_amount, size = 2) +
geom_jitter( aes(x=obj, y= as.numeric(mallows_bin_s), colour = "Mallows-Binomial"),
height = jitter_amount, width = jitter_amount, size = 2) +
scale_colour_manual(name = "Model", values = values_obj, breaks = model_names ) +
scale_y_continuous(name = "Z-score of latent quality") +
xlab("") +
xlab("Object") +
ggtitle(paste("Final ordering of all ranking, scoring and combined models (Z-score on top 10s)")) +
theme_bw() +
theme(axis.text.x = element_text(angle = 90, vjust = 0.5, hjust=0.5))
