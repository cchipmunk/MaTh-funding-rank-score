as.data.frame(cbind(res_is, res_name))
as.data.frame(cbind(grand_id, res_is))
grant_id <- unique(dat_scores$grant_id)
as.data.frame(cbind(grand_id, res_is))
as.data.frame(cbind(grant_id, res_is))
